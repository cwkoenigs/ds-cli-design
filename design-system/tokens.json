{
  "name": "ds-next terminal design system",
  "version": "1.0.0",
  "updated": "2026-10-23",
  "source": {
    "designProject": "https://claude.ai/design/p/81fef9af-a683-4f05-a370-344af3d1ea9e",
    "pages": [
      "ds-next Terminal Design System.html",
      "ds-next Screens.html"
    ],
    "derivedFrom": "Industry design system steel accent #5980a6; ok/warn/err generated in OKLCH at the accent's lightness"
  },
  "color": {
    "roles": [
      "bg",
      "surface",
      "text",
      "muted",
      "dim",
      "rule",
      "accent",
      "strong",
      "brand",
      "ok",
      "warn",
      "err",
      "hl"
    ],
    "dark": {
      "bg": "#1d1f20",
      "surface": "#2b2b2d",
      "text": "#e7e7ea",
      "muted": "#98989b",
      "dim": "#7a7a7d",
      "rule": "#424244",
      "accent": "#94bce3",
      "strong": "#b5d9fd",
      "brand": "#749dc4",
      "ok": "#7fd4a0",
      "warn": "#e3c56b",
      "err": "#ef8a7a",
      "hl": "#2c455d"
    },
    "light": {
      "bg": "#f2f2f3",
      "surface": "#e9e9ea",
      "text": "#1d1f20",
      "muted": "#5d5d60",
      "dim": "#7a7a7d",
      "rule": "#d4d4d7",
      "accent": "#416180",
      "strong": "#2c455d",
      "brand": "#5980a6",
      "ok": "#2f7d4f",
      "warn": "#8a6a12",
      "err": "#b3402e",
      "hl": "#c9dcee"
    },
    "ansi16": {
      "bg": "default",
      "surface": "default",
      "text": "default",
      "muted": "bright_black",
      "dim": "bright_black",
      "rule": "bright_black",
      "accent": "cyan",
      "strong": "bold cyan",
      "brand": "blue",
      "ok": "green",
      "warn": "yellow",
      "err": "red",
      "hl": "reverse"
    },
    "semantic": {
      "voiceYou": "strong",
      "voiceAgent": "accent",
      "voiceMachine": "muted",
      "edgeInput": "dim",
      "edgeApproval": "warn",
      "band": {
        "bg": "brand",
        "fg": "bg"
      },
      "key": {
        "bg": "accent",
        "fg": "bg"
      },
      "cursor": {
        "bg": "text",
        "fg": "bg"
      }
    },
    "rules": [
      "Colour names a voice or an outcome, never decoration",
      "Only ✓ ⚠ ✗ use ok/warn/err, plus the line that explains them",
      "One filled band per screen: the prompt tag or the submit key"
    ]
  },
  "type": {
    "mono": {
      "family": "JetBrains Mono",
      "fallback": [
        "ui-monospace",
        "Menlo",
        "SF Mono",
        "Cascadia Mono",
        "DejaVu Sans Mono",
        "monospace"
      ],
      "size": 12.5,
      "lineHeight": 19,
      "weights": [
        400,
        700
      ]
    },
    "doc": {
      "heading": "Barlow Condensed",
      "body": "Barlow"
    }
  },
  "grid": {
    "cols": 80,
    "minCols": 60,
    "indent": 2,
    "resultIndent": 4,
    "labelWidth": 12,
    "bannerLeft": 30,
    "mascotWidth": 28,
    "rhythm": "one blank line between turns, none inside a turn; frames get one above and below"
  },
  "glyphs": {
    "prompt": "›",
    "agent": "●",
    "run": "→",
    "result": "⎿",
    "rail": "│",
    "close": "╰",
    "ok": "✓",
    "warn": "⚠",
    "err": "✗",
    "select": "❯",
    "choice": [
      "‹",
      "›"
    ],
    "sep": " · ",
    "fold": "┄",
    "spinner": [
      "◐",
      "◓",
      "◑",
      "◒"
    ],
    "spinnerFps": 8,
    "retired": [
      "◆",
      "▼",
      "braille spinners",
      "rounded panels ╭╮"
    ]
  },
  "frames": {
    "corners": [
      "┌",
      "┐",
      "└",
      "┘"
    ],
    "rule": "─",
    "wall": "│",
    "bannerJoins": [
      "┬",
      "┴",
      "├",
      "┤"
    ],
    "meaning": "a frame means needs-you: form, approval; output is never boxed; the banner is the one shown-once exception"
  },
  "motion": {
    "liveLines": 1,
    "append": true,
    "foldKey": "ctrl-o",
    "cadences": {
      "spinner": "8 fps",
      "seconds": "1 Hz",
      "step": "on new message"
    }
  },
  "mascot": {
    "size": [
      28,
      20
    ],
    "legend": {
      "D": "brand",
      "C": "strong",
      "k": "bg",
      ".": "empty"
    },
    "render": "half-blocks ▀▄█, two pixel rows per text row",
    "grid": [
      "............................",
      "................C......C....",
      "....DDDDDD......CC....CC....",
      "..DDDDDDDDDD....CCCCCCCCC...",
      ".DDDDDDDDDDDD..CCCCCCCCCCC..",
      ".DDDDDDDDDDDD..CCCCCCCCCCC..",
      ".DDDkkDDDkkDD..CCkkCCCCkkC..",
      ".DDDkkDDDkkDD..CCkkCCCCkkC..",
      ".DDDDDDDDDDDD..CCCCCCCCCCC..",
      ".DDDDDkkDDDDD..CCCCCkkCCCC..",
      ".DD.DDDDDD.DD...CCCCCCCCC...",
      "....DDDDDD........CCCCC.....",
      "..CCCDDDDDDDDDCCCCCCCCCDDD..",
      "..CDDDDDDDDDDDCCCCCCCCCCCD..",
      "..DDDDDDDDDDD..CCCCCCCCCC...",
      "..DDDDDDDDDDD..CCCCCCCCCC.C.",
      "..DDDDDDDDDDD..CCCCCCCCCCCC.",
      "..DDDDDDDDDDD..CCCCCCCCCC...",
      "..DDD..DDD.....CCC..CCC.....",
      "..DDD..DDD.....CCC..CCC....."
    ]
  },
  "env": {
    "theme": "DS_THEME=light|dark",
    "truecolor": "COLORTERM=truecolor|24bit"
  }
}
